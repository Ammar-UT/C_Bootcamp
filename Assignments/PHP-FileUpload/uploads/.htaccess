# منع تشغيل ملفات PHP وأي سكربتات تنفيذية داخل مجلد المرفوعات
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|phtml|php3|php4|php5|phps|phar|inc|pl|py|cgi|sh)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|phtml|php3|php4|php5|phps|phar|inc|pl|py|cgi|sh)$">
        Order Deny,Allow
        Deny from all
    </FilesMatch>
</IfModule>
Options -Indexes -ExecCGI