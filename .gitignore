# Ignore everything by default
*
!*/

!.gitignore

# Whitelist PasswordChecker source code and executable
!PasswordChecker.c
!passchecker

# Whitelist Root Assignments
!Assignments/
!Assignments/**
Assignments/.vscode/
Assignments/**/.vscode/

# Whitelist C Programming Assignments
!C Programming/Assignments/
!C Programming/Assignments/**

# Documentation & Web
!README.md
!index.html
!docs/
!docs/**

# Ignore build artifacts / binaries
bin/
*.o
*.bin
